{
    "name": "ocolin/maclookup",
    "description": "MAC address vendor lookup with file, memory, and database drivers",
    "homepage": "https://github.com/ocolin/MacLookup",
    "type": "library",
    "keywords": [
        "mac",
        "mac-address",
        "vendor",
        "oui",
        "ieee",
        "network",
        "lookup"
    ],
    "require": {
        "ext-pdo": "*",
        "php": "^8.2",
        "ext-ctype": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-pdo_sqlite": "Required for DatabaseDriver"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ocolin\\MacLookup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ocolin\\MacLookup\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Colin Miller",
            "email": "ocolin@staff.cruzio.com"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage --display-deprecations --display-notices",
        "debug": "vendor/bin/phpunit --no-coverage --display-deprecations --display-notices --debug",
        "integration": "vendor/bin/phpunit --no-coverage --group integration",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html coverage"
    },
    "bin": [
        "bin/benchmark"
    ]
}
